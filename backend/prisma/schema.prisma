generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
  OPERATOR
  DEVELOPER
  YAYASAN
  MITRA
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING_VERIFICATION
}

enum PaymentStatus {
  CREATED
  PENDING
  SETTLEMENT
  CAPTURE
  SUCCESS
  DENY
  CANCEL
  EXPIRE
  FAILURE
  REJECTED
}

enum PaymentType {
  TOPUP
  TEST_PAYMENT
  MANUAL_PROOF
  DISBURSEMENT
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  INVALID
}

enum PaymentOpsAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum PaymentOpsAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  RESERVE
  RELEASE
}

enum TestStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DisbursementStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  FAILED
}

enum YayasanApprovalStatus {
  PENDING_MITRA_APPROVAL
  APPROVED
}

enum PriceChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MitraInviteStatus {
  PENDING
  CLAIMED
  EXPIRED
  REVOKED
}

enum CertificateType {
  INDIVIDU
  YAYASAN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessType {
  FREE
  PREMIUM
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  username         String?          @unique
  phone            String?          @unique
  passwordHash     String
  fullName         String
  role             Role             @default(USER)
  adminRoleId      String?
  adminRole        AdminRole?       @relation(fields: [adminRoleId], references: [id])
  status           AccountStatus    @default(ACTIVE)
  paymentStatus    PaymentStatus    @default(CREATED)
  freeTestStatus   TestStatus       @default(NOT_STARTED)
  paidTestStatus   TestStatus       @default(NOT_STARTED)
  myReferralCode   String?          @unique
  referredByCode   String?
  emailVerifiedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          UserProfile?
  sessions         AuthSession[]
  bridgeTickets    AuthBridgeTicket[]
  resetTokens      PasswordResetToken[]
  wallet           Wallet?
  referralCode     ReferralCode?
  testAccesses     TestAccess[]
  testSubmissions  TestSubmission[]
  testResults      TestResult[]
  paymentOrders    PaymentOrder[]
  proofs           ManualPaymentProof[]
  yayasanProfile   YayasanProfile?
  mitraProfile     MitraProfile?
  managedYayasanProfiles YayasanProfile[]       @relation("MitraManagedYayasan")
  mitraInvites     MitraInvite[]
  mitraCapacityChanges MitraCapacityChangeLog[] @relation("MitraCapacityChangedBy")
  mitraOwnedCapacityChanges MitraCapacityChangeLog[]
  createdAudits    AuditLog[]        @relation("AuditActor")

  @@index([role, status, createdAt])
  @@index([adminRoleId])
  @@index([username, role])
}

model AdminRole {
  id          String                @id @default(cuid())
  name        String                @unique
  slug        String                @unique
  description String?
  isProtected Boolean               @default(false)
  isSystem    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  users       User[]
  permissions AdminRolePermission[]
}

model AdminPermission {
  id          String                @id @default(cuid())
  key         String                @unique
  groupKey    String
  groupLabel  String
  groupOrder  Int                   @default(0)
  pageKey     String
  pageLabel   String
  pageOrder   Int                   @default(0)
  actionKey   String
  actionLabel String
  actionOrder Int                   @default(0)
  isSystem    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  roles       AdminRolePermission[]

  @@index([groupKey, groupOrder, pageOrder, actionOrder])
  @@index([pageKey, actionKey])
}

model AdminRolePermission {
  id           String          @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime        @default(now())
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserProfile {
  id          String    @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  birthDate    DateTime?
  province     String?
  city         String?
  district     String?
  village      String?
  schoolLevel  String?
  extra        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model YayasanProfile {
  id            String    @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  managedByMitraId String?
  managedByMitra User?    @relation("MitraManagedYayasan", fields: [managedByMitraId], references: [id])
  institutionName String
  referralPrice   Int      @default(0)
  mitraShare      Int      @default(0)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  approvalStatus  YayasanApprovalStatus @default(PENDING_MITRA_APPROVAL)
  approvedAt      DateTime?
  approvedByMitraId String?
  approvalLockedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([managedByMitraId, createdAt])
}

model MitraProfile {
  id            String    @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  inviteCode     String   @unique
  isVerified     Boolean  @default(false)
  isActive       Boolean  @default(true)
  capacityLimit  Int      @default(35)
  capacityUsed   Int      @default(0)
  capacityUpdatedAt DateTime?
  invites       MitraInvite[]
  capacityChangeLogs MitraCapacityChangeLog[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MitraInvite {
  id            String            @id @default(cuid())
  mitraProfileId String
  mitraProfile  MitraProfile      @relation(fields: [mitraProfileId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String            @unique
  status        MitraInviteStatus @default(PENDING)
  expiresAt     DateTime
  sentAt        DateTime?
  claimedAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, status])
  @@index([mitraProfileId, status])
}

model MitraCapacityChangeLog {
  id               String       @id @default(cuid())
  mitraProfileId   String
  mitraProfile     MitraProfile @relation(fields: [mitraProfileId], references: [id], onDelete: Cascade)
  mitraUserId      String
  mitraUser        User         @relation(fields: [mitraUserId], references: [id], onDelete: Cascade)
  changedByAdminId String?
  changedByAdmin   User?        @relation("MitraCapacityChangedBy", fields: [changedByAdminId], references: [id])
  previousLimit    Int
  newLimit         Int
  note             String?
  createdAt        DateTime     @default(now())

  @@index([mitraProfileId, createdAt])
  @@index([mitraUserId, createdAt])
}

model AuthSession {
  id              String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuthBridgeTicket {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSessionId String?
  tokenHash       String    @unique
  targetPath      String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([sourceSessionId, expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id            String    @id @default(cuid())
  actorUserId    String?
  actorUser      User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action         String
  targetType     String
  targetId       String?
  payload        Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
}

model Question {
  id               String           @id @default(cuid())
  text             String
  type             String           @default("multiple_choice")
  category         String
  testType         String           @default("free")
  socialDimension  String?          @default("none")
  targetElement    String?
  isRequired       Boolean          @default(true)
  isActive         Boolean          @default(true)
  order            Int              @default(0)
  variants         Json?
  options          QuestionOption[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([testType, category, isActive])
}

model QuestionOption {
  id          String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label        String
  value        String
  scores       Json
  order        Int      @default(0)

  @@index([questionId, order])
}

model ScoringRuleSet {
  id           String    @id @default(cuid())
  version      Int       @unique
  name         String
  isActive     Boolean   @default(false)
  effectiveAt  DateTime
  ruleJson     Json
  createdAt    DateTime  @default(now())
}

model PersonalityResultTemplate {
  id           String    @id @default(cuid())
  code         String    @unique
  socialType   String
  element      String
  label        String
  color        String
  aiAnalysis   Json
  insights     Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([socialType, element])
}

model TestSubmission {
  id              String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  category         String?
  testType         String
  status           TestStatus @default(IN_PROGRESS)
  scoringVersion   Int
  questionSnapshot Json
  submittedAt      DateTime   @default(now())
  answers          TestAnswer[]
  result           TestResult?

  @@index([userId, submittedAt])
}

model TestAnswer {
  id             String         @id @default(cuid())
  submissionId    String
  submission      TestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId      String
  selectedOption  Int

  @@index([submissionId, questionId])
}

model TestResult {
  id                String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id])
  submissionId       String?    @unique
  submission         TestSubmission? @relation(fields: [submissionId], references: [id])
  testType           String
  category           String?
  scoringVersion     Int
  personalityCode    String?
  dominantElement    String?
  socialType         String?
  elementScores      Json
  normalizedScores   Json
  freeTeaser         Json?
  paidInsights       Json?
  aiInsights         Json?
  createdAt          DateTime   @default(now())

  @@index([userId, testType, createdAt])
}

model TestAccess {
  id           String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  category      String
  accessType    AccessType
  source        String?
  createdAt     DateTime   @default(now())

  @@unique([userId, category, accessType])
  @@index([userId, createdAt])
}

model Wallet {
  id               String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id])
  availableBalance  Int          @default(0)
  reserveBalance    Int          @default(0)
  updatedAt         DateTime     @updatedAt
  entries           WalletLedger[]
}

model WalletLedger {
  id             String          @id @default(cuid())
  walletId        String
  wallet          Wallet          @relation(fields: [walletId], references: [id])
  entryType       LedgerEntryType
  amount          Int
  balanceBefore   Int
  balanceAfter    Int
  referenceType   String
  referenceId     String
  note            String?
  createdAt       DateTime        @default(now())

  @@unique([referenceType, referenceId, entryType])
  @@index([walletId, createdAt])
}

model PaymentOrder {
  id                 String        @id @default(cuid())
  orderId             String        @unique
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  paymentType         PaymentType
  amount              Int
  status              PaymentStatus @default(CREATED)
  midtransStatus      String?
  midtransFraudStatus String?
  paymentUrl          String?
  qrisUrl             String?
  idempotencyKey      String?       @unique
  metadata            Json?
  expiresAt           DateTime?
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  events              PaymentEvent[]
  manualProofs        ManualPaymentProof[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id             String        @id @default(cuid())
  paymentOrderId  String
  paymentOrder    PaymentOrder  @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  fromStatus      PaymentStatus?
  toStatus        PaymentStatus
  source          String
  payload         Json?
  createdAt       DateTime      @default(now())

  @@index([paymentOrderId, createdAt])
}

model WebhookInbox {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  provider      String   @default("midtrans")
  eventType     String?
  orderId       String?
  transactionId String?
  signatureKey  String
  sourceIp      String?
  userAgent     String?
  statusBeforeProcess String?
  nextStatus    String?
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  processAttempts Int    @default(0)
  duplicateCount Int     @default(0)
  lastDuplicateAt DateTime?
  lastError     String?
  lastProcessedBy String?
  requestLatencyMs Int?
  processingLatencyMs Int?
  receivedAt    DateTime @default(now())
  payload       Json
  processedAt   DateTime?
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([processingStatus, receivedAt])
  @@index([provider, receivedAt])
}

model PaymentOpsAlert {
  id              String                  @id @default(cuid())
  alertKey        String                  @unique
  type            String
  severity        PaymentOpsAlertSeverity
  status          PaymentOpsAlertStatus   @default(OPEN)
  title           String
  message         String
  orderId         String?
  webhookInboxId  String?
  metadata        Json?
  hitCount        Int                     @default(1)
  firstTriggeredAt DateTime               @default(now())
  lastTriggeredAt DateTime                @default(now())
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt

  @@index([status, severity, lastTriggeredAt])
  @@index([type, lastTriggeredAt])
  @@index([orderId, lastTriggeredAt])
}

model OutboxEvent {
  id          String   @id @default(cuid())
  eventType   String
  aggregateId String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([eventType, processedAt])
}

model ManualPaymentProof {
  id            String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  paymentOrderId String?
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id])
  fileUrl        String
  amount         Int
  method         String
  status         PaymentStatus @default(PENDING)
  rejectionReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

model RevenueLedger {
  id            String   @id @default(cuid())
  paymentOrderId String?
  sourceType    String
  sourceId      String?
  amount        Int
  newmeShare    Int      @default(0)
  mitraShare    Int      @default(0)
  yayasanShare  Int      @default(0)
  developerFee  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([sourceType, createdAt])
}

model Disbursement {
  id            String            @id @default(cuid())
  type          String
  userId        String?
  amount        Int
  status        DisbursementStatus @default(PENDING)
  provider      String            @default("manual")
  providerReferenceId String?
  providerStatus String?
  providerPayload Json?
  failureReason String?
  bankName      String?
  bankAccount   String?
  accountName   String?
  notes         String?
  submittedAt   DateTime?
  processedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([type, status, createdAt])
  @@index([provider, providerStatus, createdAt])
}

model ReferralSetting {
  id                    String   @id @default(cuid())
  baseCommissionPercent Int      @default(0)
  maxCommissionPercent  Int      @default(0)
  updatedAt             DateTime @updatedAt
}

model ReferralCode {
  id          String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  code         String   @unique
  createdAt    DateTime @default(now())
}

model ReferralTransaction {
  id            String   @id @default(cuid())
  userId         String
  referralCode   String
  sourceOrderId  String?
  commission     Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model YayasanPriceChangeRequest {
  id                    String                   @id @default(cuid())
  mitraId               String
  yayasanId             String
  currentYayasanShare   Int
  currentMitraShare     Int
  requestedYayasanShare Int
  requestedMitraShare   Int
  reason                String
  status                PriceChangeRequestStatus @default(PENDING)
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewNote            String?
  appliedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([mitraId, createdAt])
  @@index([yayasanId, createdAt])
  @@index([status, createdAt])
}

model CertificateTemplate {
  id           String          @id @default(cuid())
  certType     CertificateType @unique
  title        String
  body         String?
  backgroundUrl String?
  logoUrl      String?
  signatureUrl String?
  updatedAt    DateTime        @updatedAt
}

model CertificateAsset {
  id           String   @id @default(cuid())
  certType     CertificateType
  assetType    String
  fileUrl      String
  createdAt    DateTime @default(now())
}

model IssuedCertificate {
  id                 String          @id @default(cuid())
  certificateNumber  String          @unique
  userId             String?
  certType           CertificateType
  testResultId       String?
  metadata           Json?
  issuedAt           DateTime        @default(now())

  @@index([certType, issuedAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
}

model WebsiteSection {
  id          String       @id @default(cuid())
  key         String       @unique
  title       String
  isVisible   Boolean      @default(true)
  order       Int          @default(0)
  data        Json?
  updatedAt   DateTime     @updatedAt

  @@index([order])
}

model HeroSlide {
  id          String        @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  badge       String?
  imageUrl    String
  ctaText     String?
  ctaLink     String?
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
}

model HomepageProduct {
  id          String        @id @default(cuid())
  name        String
  description String?
  subtitle    String?
  imageUrl    String?
  link        String?
  badge       String?
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    String?
  imageUrl    String?
  price       Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, isActive, createdAt])
}

model Testimonial {
  id          String        @id @default(cuid())
  name        String
  organization String?
  role        String?
  quote       String
  avatarUrl   String?
  rating      Int           @default(5)
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
}

model Activity {
  id          String        @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  link        String?
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String?
  excerpt     String?
  category    String?
  tags        Json?
  content     String
  imageUrl    String?
  featuredImage String?
  isPublished Boolean       @default(true)
  viewCount   Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Banner {
  id          String        @id @default(cuid())
  title       String?
  description String?
  imageUrl    String
  type        String        @default("slider")
  linkUrl     String?
  isActive    Boolean       @default(true)
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  category    String
  name        String
  url         String
  createdAt   DateTime @default(now())
}

model RunningInfo {
  id          String        @id @default(cuid())
  message     String
  isActive    Boolean       @default(true)
  linkText    String?
  linkUrl     String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  message     String
  status      String   @default("new")
  notes       String?
  createdAt   DateTime @default(now())
}

model InstitutionInquiry {
  id          String   @id @default(cuid())
  name        String
  contact     String
  message     String
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model RegistrationLead {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  source      String?
  createdAt   DateTime @default(now())
}

model PageView {
  id          String   @id @default(cuid())
  page        String
  sessionId   String
  userId      String?
  createdAt   DateTime @default(now())

  @@index([page, createdAt])
  @@index([sessionId, createdAt])
}

model OnlineSession {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  lastSeenAt   DateTime
  createdAt    DateTime @default(now())

  @@index([lastSeenAt])
}
