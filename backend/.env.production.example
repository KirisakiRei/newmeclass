# This file is documentation only.
# In CI/CD production, GitHub Actions writes /opt/newme/.env.production on the VPS.

# Images pulled from GHCR
FRONTEND_IMAGE=ghcr.io/kirisakirei/newmeclass-frontend
BACKEND_IMAGE=ghcr.io/kirisakirei/newmeclass-backend
BACKEND_TOOLS_IMAGE=ghcr.io/kirisakirei/newmeclass-backend-tools
IMAGE_TAG=prod-latest

# Docker Compose / frontend runtime
FRONTEND_PORT=80
REACT_APP_BACKEND_URL=

# Public app URLs
APP_URL=https://your-domain.tld
FRONTEND_URL=https://your-domain.tld
CORS_ORIGINS=https://your-domain.tld
UPLOAD_PUBLIC_BASE_URL=https://your-domain.tld/uploads

# App
NODE_ENV=production
PORT=5000
API_PREFIX=api
APP_NAME=NEWME Backend
TZ=Asia/Jakarta
LOG_LEVEL=info
TRUST_PROXY=true

# Database
MYSQL_DATABASE=NEWME_DB
MYSQL_USER=NEWME_ADMIN
MYSQL_PASSWORD=replace_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
DATABASE_URL=mysql://replace_user:replace_password@mysql:3306/replace_database
DIRECT_URL=mysql://replace_user:replace_password@mysql:3306/replace_database
DB_TX_TIMEOUT_MS=8000

# Auth
JWT_ACCESS_SECRET=replace_with_a_minimum_16_char_access_secret
JWT_REFRESH_SECRET=replace_with_a_minimum_16_char_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_REGISTER_LIMIT=20
AUTH_RATE_LIMIT_LOGIN_LIMIT=20
AUTH_RATE_LIMIT_ADMIN_LOGIN_LIMIT=8
AUTH_RATE_LIMIT_PASSWORD_RECOVERY_LIMIT=8
CERT_DOWNLOAD_RATE_LIMIT_TTL=60
CERT_DOWNLOAD_RATE_LIMIT=30
CERT_AI_DOWNLOAD_RATE_LIMIT=20
CERT_GENERATE_RATE_LIMIT=15

# Redis / BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=newme
BULLMQ_DEFAULT_REMOVE_ON_COMPLETE=1000
BULLMQ_DEFAULT_REMOVE_ON_FAIL=5000
QUEUE_CONCURRENCY_PAYMENT=10
QUEUE_CONCURRENCY_SCORING=20

# Midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=replace_midtrans_server_key
MIDTRANS_CLIENT_KEY=replace_midtrans_client_key
MIDTRANS_MERCHANT_ID=replace_midtrans_merchant_id
MIDTRANS_SANITIZED=true
MIDTRANS_3DS=true
MIDTRANS_WEBHOOK_PATH=/api/payments/midtrans/webhook

# Payment reconcile
PAYMENT_RECONCILE_CRON=*/5 * * * *
PAYMENT_RECONCILE_WINDOW_MINUTES=120

# Storage local
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_EXT=jpg,jpeg,png,webp
ALLOWED_DOC_EXT=pdf

# Mail (optional if email is not active yet)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NEWME
SMTP_FROM_EMAIL=no-reply@newme.id
SMTP_SECURE=false

# Certificate
CERT_TEMPLATE_DIR=./uploads/certificates/templates
CERT_OUTPUT_DIR=./uploads/certificates/generated
CERT_NUMBER_PREFIX=NEWME
CERT_TIMEZONE=Asia/Jakarta

# Cron
CRON_ANALYTICS_CLEANUP=0 */6 * * *
CRON_TEMP_FILES_CLEANUP=0 3 * * *

# Seed admin
SEED_SUPERADMIN_EMAIL=admin@newme.id
SEED_SUPERADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_SUPERADMIN_NAME=Super Admin
