FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

ARG REACT_APP_BACKEND_URL=
ARG REACT_APP_PUBLIC_WEB_URL=
ARG REACT_APP_DASHBOARD_URL=
ARG REACT_APP_FRONTEND_URL=
ARG REACT_APP_SITE_URL=
ARG MIDTRANS_PUBLIC_CLIENT_KEY=
ARG REACT_APP_MIDTRANS_IS_PRODUCTION=false
ARG GENERATE_COMPRESSED_ASSETS=true

COPY . .
RUN REACT_APP_BACKEND_URL="${REACT_APP_BACKEND_URL}" \
  REACT_APP_PUBLIC_WEB_URL="${REACT_APP_PUBLIC_WEB_URL}" \
  REACT_APP_DASHBOARD_URL="${REACT_APP_DASHBOARD_URL}" \
  REACT_APP_FRONTEND_URL="${REACT_APP_FRONTEND_URL}" \
  REACT_APP_SITE_URL="${REACT_APP_SITE_URL}" \
  REACT_APP_MIDTRANS_CLIENT_KEY="${MIDTRANS_PUBLIC_CLIENT_KEY}" \
  REACT_APP_MIDTRANS_IS_PRODUCTION="${REACT_APP_MIDTRANS_IS_PRODUCTION}" \
  GENERATE_COMPRESSED_ASSETS="${GENERATE_COMPRESSED_ASSETS}" \
  npm run build

FROM nginx:1.27-alpine AS runtime
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
