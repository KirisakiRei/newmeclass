# App URLs
APP_URL=http://localhost:5000
PUBLIC_FRONTEND_URL=http://localhost:8081
DASHBOARD_FRONTEND_URL=http://localhost:8080
CMS_FRONTEND_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080,http://127.0.0.1:8080
UPLOAD_PUBLIC_BASE_URL=http://localhost/uploads

# Frontend / Nginx
FRONTEND_PORT=8081
APP_FRONTEND_PORT=8080
VITE_BACKEND_URL=
VITE_DASHBOARD_URL=http://localhost:8080
NGINX_BACKEND_UPSTREAM=http://backend:5000
REACT_APP_BACKEND_URL=
REACT_APP_PUBLIC_WEB_URL=http://localhost:8081
REACT_APP_DASHBOARD_URL=http://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:8080
REACT_APP_SITE_URL=http://localhost:8080
REACT_APP_MIDTRANS_CLIENT_KEY=replace_midtrans_client_key
REACT_APP_MIDTRANS_IS_PRODUCTION=false
GENERATE_COMPRESSED_ASSETS=true

# App runtime
NODE_ENV=production
PORT=5000
API_PREFIX=api
APP_NAME=NEWME Backend
TZ=Asia/Jakarta
LOG_LEVEL=info
TRUST_PROXY=true

# Database
MYSQL_DATABASE=NEWME_DB
MYSQL_USER=NEWME_ADMIN
MYSQL_PASSWORD=replace_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
DATABASE_URL=mysql://replace_user:replace_password@database:3306/replace_database
DIRECT_URL=mysql://replace_user:replace_password@database:3306/replace_database
DB_TX_TIMEOUT_MS=8000

# Auth
JWT_ACCESS_SECRET=replace_with_a_minimum_16_char_access_secret
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_ACCESS_TTL_USER=20m
AUTH_ACCESS_TTL_STAFF=15m
AUTH_REFRESH_TTL_DAYS=30
AUTH_ENABLE_GOOGLE=false
AUTH_ENABLE_PASSWORD_RESET=true
CSP_REPORT_ONLY=false
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_REGISTER_LIMIT=20
AUTH_RATE_LIMIT_LOGIN_LIMIT=20
AUTH_RATE_LIMIT_ADMIN_LOGIN_LIMIT=8
AUTH_RATE_LIMIT_PASSWORD_RECOVERY_LIMIT=8
CERT_DOWNLOAD_RATE_LIMIT_TTL=60
CERT_DOWNLOAD_RATE_LIMIT=30
CERT_AI_DOWNLOAD_RATE_LIMIT=20
CERT_GENERATE_RATE_LIMIT=15

# Redis / Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=newme
BULLMQ_DEFAULT_REMOVE_ON_COMPLETE=1000
BULLMQ_DEFAULT_REMOVE_ON_FAIL=5000
QUEUE_CONCURRENCY_PAYMENT=10
QUEUE_CONCURRENCY_SCORING=20

# Payments
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=replace_midtrans_server_key
MIDTRANS_CLIENT_KEY=replace_midtrans_client_key
MIDTRANS_MERCHANT_ID=replace_midtrans_merchant_id
DISBURSEMENT_PROVIDER=manual
MIDTRANS_IRIS_API_KEY=
MIDTRANS_IRIS_SANDBOX_API_KEY=
MIDTRANS_IRIS_PRODUCTION_API_KEY=
MIDTRANS_IRIS_SANDBOX_BASE_URL=https://app.sandbox.midtrans.com/iris/api/v1
MIDTRANS_IRIS_PRODUCTION_BASE_URL=https://app.midtrans.com/iris/api/v1
MIDTRANS_IRIS_PAYOUTS_PATH=/payouts
MIDTRANS_SANITIZED=true
MIDTRANS_3DS=true
MIDTRANS_WEBHOOK_PATH=/api/payments/midtrans/webhook
PAYMENT_RECONCILE_CRON=*/5 * * * *
PAYMENT_RECONCILE_WINDOW_MINUTES=120

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_EXT=jpg,jpeg,png,webp
ALLOWED_DOC_EXT=pdf

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_email_sender
SMTP_PASS=replace_gmail_app_password
SMTP_FROM_NAME=NEWME
SMTP_FROM_EMAIL=replace_email_sender
SMTP_SECURE=false

# Certificate
CERT_TEMPLATE_DIR=./uploads/certificates/templates
CERT_OUTPUT_DIR=./uploads/certificates/generated
CERT_NUMBER_PREFIX=NEWME
CERT_TIMEZONE=Asia/Jakarta

# Cron
CRON_ANALYTICS_CLEANUP=0 */6 * * *
CRON_TEMP_FILES_CLEANUP=0 3 * * *

# Seed admin
SEED_SUPERADMIN_EMAIL=admin@newme.id
SEED_SUPERADMIN_PASSWORD=newmeadmin123
SEED_SUPERADMIN_NAME=Super Admin
